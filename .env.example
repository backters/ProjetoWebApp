# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# E-mail de destino para receber os diagnósticos automaticamente:
RECIPIENT_EMAIL="fabianaberkana@gmail.com"

# Provedores de e-mail suportados (configure um na Vercel ou no arquivo .env):
# 1. Resend (Recomendado para Vercel: gratuito e sem complicação em resend.com):
RESEND_API_KEY=""

# 2. Ou SMTP (Gmail, Zoho, Hostgator, etc.):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Método Berkana <noreply@metodoberkana.com>"
